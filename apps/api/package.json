{
  "name": "@gigachads.de/api",
  "version": "1.0.0",
  "license": "Unlicense",
  "author": {
    "name": "sweetdaisybee",
    "url": "https://github.com/sweetdaisybee"
  },
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "homepage": "https://github.com/sweetdaisybee/gigachads.de",
  "bugs": {
    "url": "https://github.com/sweetdaisybee/gigachads.de/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gigachads-de/gigachads.de.git",
    "directory": "apps/api"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "os": [
    "linux",
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "scripts": {
    "dev": "tsx watch --env-file=.env ./src/index.ts",
    "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "clean": "rimraf dist .tsbuildinfo .turbo node_modules",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js",
    "typecheck": "tsc --noEmit",
    "seed": "node ./src/configs/prisma/seed.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/redis": "^7.2.0",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@gigachads.de/prisma": "workspace:*",
    "@gigachads.de/shared": "workspace:*",
    "argon2": "^0.44.0",
    "fastify": "^5.8.4",
    "fastify-type-provider-zod": "^6.1.0",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@gigachads.de/eslint": "workspace:*",
    "@gigachads.de/jest": "workspace:*",
    "@gigachads.de/typescript": "workspace:*",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0"
  }
}
