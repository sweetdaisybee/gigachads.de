{
  "extends": "@gigachads.de/typescript/node.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": ".tsbuildinfo",
    "rootDir": "src",
    "paths": {
      "@index": ["./src//index.js"],
      "@configs/*": ["./src/configs/*"],
      "@generated/*": ["./src/generated/*"]
    },
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", ".turbo", ".tsbuildinfo", "**/*.test*"]
}