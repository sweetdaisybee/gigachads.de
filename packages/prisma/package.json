{
  "name": "@gigachads.de/prisma",
  "version": "1.0.0",
  "license": "Unlicense",
  "author": {
    "name": "sweetdaisybee",
    "url": "https://github.com/sweetdaisybee"
  },
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "homepage": "https://github.com/sweetdaisybee/gigachads.de",
  "bugs": {
    "url": "https://github.com/sweetdaisybee/gigachads.de/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gigachads-de/gigachads.de.git",
    "directory": "packages/prisma"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "os": [
    "linux",
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc && (concurrently \"tsc --watch\" \"tsc-alias --watch\")",
    "build": "tsc --build && tsc-alias -p tsconfig.json",
    "clean": "rimraf dist .tsbuildinfo .turbo node_modules",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --no-hints",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:reset": "prisma migrate reset",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:format": "prisma format"
  },
  "devDependencies": {
    "@gigachads.de/typescript": "workspace:*",
    "concurrently": "^9.2.1",
    "prisma": "^7.5.0",
    "tsc-alias": "^1.8.17"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "better-sqlite3": "^12.8.0",
    "zod": "^4.3.6"
  }
}
